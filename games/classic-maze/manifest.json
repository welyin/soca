{
  "game": "classic-maze",
  "kind": "maze",
  "title": "传统迷宫",
  "adapter": "games/adapters/minigrid/driver.py",
  "default_level": "walls",
  "engine": {
    "kind": "minigrid",
    "package": "minigrid",
    "pinned_version": "3.1.0",
    "runtime": "gymnasium",
    "runtime_pinned_version": "1.3.0",
    "licence": "Apache-2.0",
    "source": "https://github.com/Farama-Foundation/Minigrid"
  },
  "public": {
    "observation_mode": "symbolic_maze",
    "view_size": 7,
    "mission_max_chars": 2048,
    "actions": ["turn_left", "turn_right", "forward", "pickup", "toggle"],
    "action_ids": {
      "turn_left": 0,
      "turn_right": 1,
      "forward": 2,
      "pickup": 3,
      "toggle": 5
    },
    "withheld": [
      "absolute_position",
      "full_map",
      "seed",
      "rng_state",
      "info",
      "expert_actions",
      "drop",
      "done"
    ],
    "view_convention": {
      "kind": "agent_centric_rotating",
      "agent_row": 3,
      "agent_column": 6,
      "forward_column_delta": -1,
      "left_row_delta": -1,
      "note": "视图随 agent 朝向旋转，因此前方在视图里恒定。列的增减对应前后、行的增减对应左右；这条约定是规则事实，不含隐藏状态，认知单元靠它做无漂移里程计。由 games/adapters/minigrid/tests/test_conformance.py 的位移测试守住。"
    }
  },
  "levels": {
    "walls": {
      "title": "墙与缺口（9×9）",
      "env_id": "MiniGrid-SimpleCrossingS9N1-v0",
      "rules_version": "classic-maze-walls-s9-v1",
      "budget": {
        "max_steps": 324,
        "reward_range": [0.0, 1.0],
        "win_condition": "find the opening in the wall and reach the goal"
      },
      "note": "传统的那一种：一道墙把格子分成两半，墙上有缺口，从起点绕到终点。世界里只有墙、空地和目标——没有钥匙，没有门。"
    },
    "four-rooms": {
      "title": "四房间（19×19）",
      "env_id": "MiniGrid-FourRooms-v0",
      "rules_version": "classic-maze-four-rooms-v1",
      "budget": {
        "max_steps": 400,
        "reward_range": [0.0, 1.0],
        "win_condition": "reach the goal"
      },
      "note": "同样的规则，四个房间各开一个口。地方大得多——一份目标的激活额度大概率不够走到终点，恰好用来看§4.2那个升级触发器。"
    }
  },
  "scoring": {
    "exposed_reward": "0.0 until the episode ends, then the terminal reward",
    "note": "进步奖励若要加入必须新开一个 manifest 版本，并检查是否泄露真值（§11.3）"
  },
  "recovery": {
    "supports_snapshot": false,
    "why": "MiniGrid 的 unwrapped 局面无法从公开观测重建。未验证可恢复的适配器必须把回合标为基础设施截断，不得 reset 后冒充继续（§13）"
  }
}
